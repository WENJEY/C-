                "program": "${workspaceFolder}/build/C_.exe",
                "miDebuggerPath": "${workspaceFolder}/scripts/gdb.cmd"
            },
            "osx": {
                "MIMode": "lldb"
            }
        },
        {
            "name": "Run C_ (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/C_.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "externalTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "CMake Build"
        }
    ]
