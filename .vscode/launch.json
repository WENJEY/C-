{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run C_ (gdb/lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/C_",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "stopAtEntry": false,
            "MIMode": "gdb",
